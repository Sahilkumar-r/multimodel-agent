# ============================================================================
# Copy this file to `.env` and fill in your keys:  cp .env.example .env
# Never commit .env (it is in .gitignore).
# ============================================================================

# ---- LLM providers (set at least one; set all three for automatic fallback) --
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Which provider handles requests first (openai | anthropic | xai).
# If it fails, LiteLLM falls back to the other providers that have a key.
PRIMARY_PROVIDER=openai

# Model names are only defaults: check each provider's current model list.
# "smart" = answer writing + image analysis, "fast" = routing, grading, rewriting, guardrail judge.
# OPENAI_SMART_MODEL=gpt-4o
# OPENAI_FAST_MODEL=gpt-4o-mini
# ANTHROPIC_SMART_MODEL=claude-sonnet-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# XAI_SMART_MODEL=grok-4
# XAI_FAST_MODEL=grok-3-mini

# Pin one agent role to a specific gateway alias (<provider>-smart | <provider>-fast), e.g.:
# MODEL_ANSWER=anthropic-smart
# MODEL_SUPERVISOR=openai-fast
# Roles: SUPERVISOR, QUERY_REWRITER, GRADER, WEB_AGENT, ANSWER, VISION, GUARDRAIL

# ---- Pinecone ----------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX=multimodal-rag-agent
PINECONE_NAMESPACE=default
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- LangSmith (logging + tracing) ---------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=multimodal-rag-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # EU region only

# ---- Embeddings / re-ranker (Hugging Face, run locally) ------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-base-en-v1.5
# Instruction prefix for BGE query embeddings. Set to an empty value for models that need none.
# QUERY_INSTRUCTION=Represent this sentence for searching relevant passages: 

# ---- Chunking (semantic split + recursive size guard) ----------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_CHUNK_CHARS=250
SEMANTIC_BREAKPOINT_PERCENTILE=85

# ---- OCR (Tesseract) ---------------------------------------------------------------
# auto   = OCR only pages/images with little or no native text
# always = OCR every PDF page too and keep the longer text
# off    = never OCR
OCR_MODE=auto
OCR_LANG=eng
OCR_DPI=200
# Path to the tesseract binary if it is not on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# ---- Retrieval ------------------------------------------------------------------------
DENSE_TOP_K=20
SPARSE_TOP_K=20
RRF_K=60
RRF_POOL=30
RERANK_TOP_N=6
QUERY_VARIANTS=2

# ---- Corrective RAG ---------------------------------------------------------------------
# >= this many relevant chunks -> "correct"; 0 -> "incorrect" (web search); in between -> "ambiguous" (both)
CRAG_MIN_RELEVANT=2
WEB_MAX_RESULTS=5

# ---- Agents ----------------------------------------------------------------------------------
MAX_SUPERVISOR_STEPS=4
MAX_ANSWER_RETRIES=1

# ---- Guardrails (DeepEval) ---------------------------------------------------------------------
GUARDRAILS_ENABLED=true
GUARD_INPUT_LLM=true
GUARD_OUTPUT_LLM=true
GUARD_FAITHFULNESS=true
# true  = if the guard itself errors (e.g. judge call fails), let the message through
GUARD_FAIL_OPEN=true
GUARD_INPUT_THRESHOLD=0.5
GUARD_FAITHFULNESS_THRESHOLD=0.7
GUARD_RELEVANCY_THRESHOLD=0.6
GUARD_TOXICITY_THRESHOLD=0.5
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# ---- Paths / logging ---------------------------------------------------------------------------
# DATA_DIR=data
# CACHE_DIR=.cache
LOG_LEVEL=WARNING
